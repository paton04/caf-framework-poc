# Copy this file to .env.local (which is gitignored) and fill in the real
# values from your Supabase project settings (Settings -> Data API).
#
# Both of these are safe to expose in the browser — they're the "anon" /
# public keys. Access control is enforced by Postgres RLS policies, not by
# keeping these secret. Never put the service_role key in this file or in
# any NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — only needed for the Admin page's invite/disable/delete/
# reset-password/reset-MFA user management (src/app/actions/user-admin.ts).
# This is the OPPOSITE of the keys above: full admin access, bypasses RLS
# entirely, NEVER goes in a NEXT_PUBLIC_ variable, NEVER reaches the
# browser. From Supabase: Project Settings -> API -> service_role secret.
# Add the real value to Vercel's project env vars too (production scope)
# for this to work on the deployed app, not just locally.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
